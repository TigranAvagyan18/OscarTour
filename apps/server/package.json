	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"dev": "nest start --watch",
		"dev:swc": "nest start -b swc -w",
		"scraper": "ts-node src/scraper.ts",
		"start": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"typecheck": "tsc --noEmit",
		"db": "env-cmd -f ../../.env node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js",
		"migration:create": "pnpm db migration:create",
		"migration:generate": "pnpm db migration:generate -d src/config/data-source-db.ts",
		"migration:run": "pnpm db migration:run -d src/config/data-source-db.ts",
		"migration:revert": "pnpm db migration:revert -d src/config/data-source-db.ts",
		"schema:drop": "pnpm db schema:drop -d src/modules/database/data-source-db.ts",
		"schema:log": "pnpm db schema:log -d src/modules/database/data-source-db.ts"
	},
