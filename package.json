{
  "name": "FlowerFinder",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "codegen": "turbo run codegen --scope=client",
    "dev": "dotenv -- turbo dev",
    "dev:client": "dotenv -- turbo run dev --scope=client",
    "dev:server": "dotenv -- turbo dev --scope=server --filter=shared",
    "dev:metrics": "dotenv -- turbo dev --scope=metrics",
    "build": "dotenv -- turbo build",
    "build:client": "dotenv -- turbo build --scope=client",
    "build:server": "dotenv -- turbo build --scope=server",
    "build:metrics": "dotenv -- turbo build --scope=metrics",
    "build:landing": "dotenv -- turbo build --scope=landing",
    "dist:client": "dotenv -- turbo run start --filter=client",
    "dist:server": "dotenv -- turbo run start --filter=server",
    "dist:metrics": "dotenv -- turbo run start --filter=metrics",
    "migration:run": "dotenv -- turbo run migration:run --filter=server",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
		"@typescript-eslint/parser": "^7.0.2",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.11",
    "prettier": "^3.1.1",
    "turbo": "1.13.0"
  },
  "engines": {
    "node": ">=18"
  }
}
